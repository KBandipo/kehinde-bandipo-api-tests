				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "27be2660-04fb-428f-aa6d-46dd1623b472",
								"exec": [
									"const jsonData = pm.response.json();\r",
									"pm.collectionVariables.set(\"registered_Id\", jsonData.id);\r",
									"pm.collectionVariables.set(\"registered_Token\", jsonData.token);\r",
									"pm.test(\"Status code is 200\", ()=> {\r",
									"    pm.response.to.have.status(200);\r",
									"})\r",
									"pm.test(\"Status message is OK\", ()=> {\r",
									"    pm.response.to.have.status(\"OK\");\r",
									"});\r",
									"pm.test(\"Response time is less than 1000ms\", () => {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
									"});\r",
									"\r",
									"pm.test(\"Validate the response properties and their datatypes\", () => {\r",
									"    pm.expect(jsonData).to.be.an(\"object\");\r",
									"    pm.expect(jsonData).to.have.property(\"id\");\r",
									"    pm.expect(jsonData).to.have.property(\"token\");\r",
									"    pm.expect(jsonData.id).to.be.a(\"number\");\r",
									"    pm.expect(jsonData.token).to.be.a(\"string\");\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"id": "2f2af331-9447-4028-9e8a-52d68b2ecb99",
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "POST",
