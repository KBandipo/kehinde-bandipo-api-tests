				{
					"name": "Create a User",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "27be2660-04fb-428f-aa6d-46dd1623b472",
								"exec": [
									"const jsonData = pm.response.json();\r",
									"pm.collectionVariables.set(\"new_id\", jsonData.id);\r",
									"const req = JSON.parse(pm.request.body.raw);\r",
									"\r",
									"pm.test(\"Status code is 201\", ()=> {\r",
									"    pm.response.to.have.status(201);\r",
									"})\r",
									"pm.test(\"Status message is Created\", ()=> {\r",
									"    pm.response.to.have.status(\"Created\");\r",
									"});\r",
									"pm.test(\"Response time is less than 1000ms\", ()=> {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
									"});\r",
									"pm.test(\"Response should be an object\", ()=> {\r",
									"    pm.expect(jsonData).to.be.an(\"object\");\r",
									"\r",
									"})\r",
									"pm.test(\"Response should not be empty\", () => {\r",
									"    pm.expect(jsonData).to.not.be.empty;\r",
									"});\r",
									"\r",
									"pm.test(\"Validate the response properties and their datatypes\", () => {\r",
									"    pm.expect(jsonData).to.have.property(\"email\");\r",
									"    pm.expect(jsonData).to.have.property(\"password\");\r",
									"    pm.expect(jsonData).to.have.property(\"id\");\r",
									"    pm.expect(jsonData).to.have.property(\"createdAt\");\r",
									"    pm.expect(jsonData.email).to.be.a(\"string\");\r",
									"    pm.expect(jsonData.password).to.be.a(\"string\");\r",
									"    pm.expect(jsonData.id).to.be.a(\"string\");\r",
									"    pm.expect(jsonData.createdAt).to.be.a(\"string\");\r",
									"});\r",
									"\r",
									"pm.test(\"Validate the user creation logic\", () => {\r",
									"    pm.expect(jsonData.email).to.equal(req.email);\r",
									"    pm.expect(jsonData.password).to.equal(req.password);\r",
									"});\r",
									"\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
