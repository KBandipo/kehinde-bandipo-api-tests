				{
					"name": "List Users",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "be84b475-3cab-467a-bb44-d09f96d3f119",
								"exec": [
									"const jsonData = pm.response.json();\r",
									"const page_number = parseInt(pm.collectionVariables.get(\"page_number\"));\r",
									"\r",
									"pm.test(\"Status code is 200\", ()=> {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"pm.test(\"Status message is OK\", ()=> {\r",
									"    pm.response.to.have.status(\"OK\");\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Response time is less than 500ms\", ()=> {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
									"});\r",
									"pm.test(\"Response should be an object\", ()=> {\r",
									"    pm.expect(jsonData).to.be.an(\"object\");\r",
									"})\r",
									"\r",
									"pm.test(\"Page number is correct\", ()=> {\r",
									"    pm.expect(jsonData.page).to.be.a(\"number\");\r",
									"    pm.expect(jsonData.page).to.eql(page_number);\r",
									"});\r",
									"\r",
									"pm.test(\"Per_page should be a number\", ()=> {\r",
									"    pm.expect(jsonData.per_page).to.be.a(\"number\");\r",
									"})\r",
									"pm.test(\"Total should be a number\", () => {\r",
									"    pm.expect(jsonData.total).to.be.a(\"number\");\r",
									"});\r",
									"pm.test(\"Total_pages should be a number\", () => {\r",
									"    pm.expect(jsonData.total_pages).to.be.a(\"number\");\r",
									"});\r",
									"pm.test(\"Data should be an array\", () => {\r",
									"    pm.expect(jsonData.data).to.be.an(\"array\");\r",
									"});\r",
									"pm.test(\"Response should have data\", () => {\r",
									"    pm.expect(jsonData.data).to.not.be.empty;\r",
									"})\r",
									"pm.test(\"Data should be a object\", ()=> {\r",
									"    pm.expect(jsonData.data[0]).to.be.an(\"object\");\r",
									"})\r",
									"pm.test(\"Data should have id, email, first_name, last_name, avatar\", () => {\r",
									"    pm.expect(jsonData.data[0]).to.have.property(\"id\");\r",
									"    pm.expect(jsonData.data[0]).to.have.property(\"email\");\r",
									"    pm.expect(jsonData.data[0]).to.have.property(\"first_name\");\r",
									"    pm.expect(jsonData.data[0]).to.have.property(\"last_name\");\r",
									"    pm.expect(jsonData.data[0]).to.have.property(\"avatar\");\r",
									"})\r",
									"\r",
									"pm.test(\"Data id, email, first_name, last_name, avatar should have correct data types\", () => {\r",
									"    pm.expect(jsonData.data[0].id).to.be.a(\"number\");\r",
									"    pm.expect(jsonData.data[0].email).to.be.a(\"string\");\r",
									"    pm.expect(jsonData.data[0].first_name).to.be.a(\"string\");\r",
									"    pm.expect(jsonData.data[0].last_name).to.be.a(\"string\");\r",
									"    pm.expect(jsonData.data[0].avatar).to.be.a(\"string\");\r",
									"})\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
